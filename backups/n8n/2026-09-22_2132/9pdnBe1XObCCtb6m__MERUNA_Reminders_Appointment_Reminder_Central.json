   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT public.communication_suppress_appointment('{{$json.clinic_id}}'::uuid,'{{$json.appointment_id}}'::uuid,'{{$json.source_event_id}}'::uuid,'BUSINESS_APPOINTMENT_CHANGE') AS suppressed;",
    "options": {}
   },
