  {
   "id": "dashboard-followup-normalize",
   "name": "07 Normalize Dashboard Follow-up Intake",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    520,
    900
   ],
   "parameters": {
    "jsCode": "const input = $input.first().json || {};\nconst body = input.body && typeof input.body === 'object' ? input.body : input;\nconst pick = (key, fallback) => body[key] ?? (body.payload && body.payload[key]) ?? fallback ?? null;\nconst clinicId = pick('clinic_id', null);\nconst appointmentId = pick('appointment_id', null);\nconst followupStartAt = pick('followup_start_at', pick('start_at', null));\nconst caseSummary = pick('case_summary', pick('summary', null));\nconst createdByStaffId = pick('created_by_staff_id', pick('staff_id', null));\nconst followupGoal = pick('followup_goal', 'CHECK_IN');\nconst errors = [];\nconst uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nif (!uuidPattern.test(String(clinicId || ''))) errors.push('clinic_id is required and must be a UUID');\nif (!uuidPattern.test(String(appointmentId || ''))) errors.push('appointment_id is required and must be a UUID');\nif (!followupStartAt || Number.isNaN(Date.parse(String(followupStartAt)))) errors.push('followup_start_at is required and must be an ISO timestamp');\nif (createdByStaffId && !uuidPattern.test(String(createdByStaffId))) errors.push('created_by_staff_id must be a UUID when provided');\nif (!['CHECK_IN', 'TREATMENT_RESPONSE', 'POST_VISIT'].includes(String(followupGoal))) errors.push('followup_goal is invalid');\nif (caseSummary != null && String(caseSummary).length > 12000) errors.push('case_summary exceeds 12000 characters');\nfunction sqlLit(value) {\n  if (value === null || value === undefined || value === '') return 'NULL';\n  return String.fromCharCode(39) + String(value).replaceAll(String.fromCharCode(39), String.fromCharCode(39,39)) + String.fromCharCode(39);\n}\nconst createCaseQuery = errors.length === 0\n  ? 'SELECT public.followup_create_employee_case(' + sqlLit(clinicId) + '::uuid, ' + sqlLit(appointmentId) + '::uuid, ' + sqlLit(followupStartAt) + '::timestamptz, ' + sqlLit(caseSummary == null ? null : String(caseSummary)) + '::text, ' + sqlLit(createdByStaffId) + '::uuid, ' + sqlLit(followupGoal) + '::text) AS result;'\n  : null;\nreturn [{json: {...body, clinic_id: clinicId, appointment_id: appointmentId, followup_start_at: followupStartAt, case_summary: caseSummary == null ? null : String(caseSummary), created_by_staff_id: createdByStaffId, followup_goal: followupGoal, intake_valid: errors.length === 0, intake_errors: errors, create_case_query: createCaseQuery}}];",
    "mode": "runOnceForAllItems"
   }
  },
