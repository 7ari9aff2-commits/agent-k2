   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT * FROM public.k2_complete_deferred_batch_v2($1::uuid, $2::uuid, ($3::text = 'success'), $4::text) LIMIT 2;",
    "options": {
     "queryReplacement": "={{ [$(\"Build Deferred Core Payload\").first().json._worker.batch_id, $(\"Build Deferred Core Payload\").first().json._worker.claim_token, $(\"Validate Deferred Delivery\").first().json.delivery_success === true ? \"success\" : \"failed\", JSON.stringify($(\"Validate Deferred Delivery\").first().json).slice(0, 1000)] }}"
    }
   },
   "credentials": {
    "postgres": {
     "id": "fHnmSTQ08g9kcLZi",
     "name": "Postgres account"
    }
   }
  },
  {
   "id": "2301c5f2-f158-4232-b931-514b631771df",
   "name": "Log K2 Deferred Outcome",
   "notesInFlow": true,
   "notes": "Operational telemetry only. Stores batch outcome and attempt count; no message content and no token quota.",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.7,
   "retryOnFail": true,
   "maxTries": 2,
   "waitBetweenTries": 1000,
   "onError": "continueRegularOutput",
   "position": [
    1440,
    0
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT * FROM public.k2_log_operational_event(\n  CASE WHEN $1::text = 'completed' THEN 'deferred_completed' ELSE 'deferred_failed' END,\n  $2::uuid,\n  $3::uuid,\n  $4::uuid,\n  $1::text,\n  CASE WHEN $1::text = 'completed' THEN 'processed' ELSE 'requeued_or_dead' END,\n  jsonb_build_object('batch_id', $5::text, 'attempts', $6::integer, 'item_count', $7::integer, 'worker_status', $8::text)\n) LIMIT 1;",
    "options": {
     "queryReplacement": "={{ [$(\"Complete Deferred Batch\").first().json.final_status || \"failed\", $(\"Build Deferred Core Payload\").first().json.clinic_id, $(\"Build Deferred Core Payload\").first().json.patient_id, $(\"Build Deferred Core Payload\").first().json.conversation_id, $(\"Build Deferred Core Payload\").first().json._worker.batch_id, $(\"Build Deferred Core Payload\").first().json._worker.attempts || 0, $(\"Build Deferred Core Payload\").first().json._worker.item_count || 0, $(\"Complete Deferred Batch\").first().json.updated === true ? \"updated\" : \"claim_lost\"] }}"
    }
   },
   "credentials": {
    "postgres": {
     "id": "fHnmSTQ08g9kcLZi",
     "name": "Postgres account"
    }
   }
  },
  {
   "id": "k2-build-deferred-delivery",
   "name": "Build Deferred Delivery Request",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1200,
    0
   ],
   "parameters": {
    "mode": "runOnceForEachItem",
    "language": "javaScript",
    "jsCode": "const core = $json || {};\nconst source = $('Build Deferred Core Payload').first().json || {};\nconst outgoingMessageId = String(core.outgoing_message_id || '').trim();\nconst deliveryPayload = outgoingMessageId ? { conversation_id: source.conversation_id, message_id: outgoingMessageId } : null;\nconst alreadyProcessed = core.duplicate === true && String(core.message || '') === 'already_processed';\nreturn { json: { ...core, _deferred_delivery: { conversation_id: source.conversation_id, message_id: outgoingMessageId || null, payload: deliveryPayload, missing_message_id: !outgoingMessageId, already_processed: alreadyProcessed } } };"
   }
  },
  {
   "id": "k2-call-deferred-dispatcher",
   "name": "Call K2 Outbound Dispatcher",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.5,
   "position": [
    1440,
    0
   ],
   "parameters": {
    "method": "POST",
    "url": "https://n8n-production-33955.up.railway.app/webhook/inbox-outbound",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "contentType": "json",
    "jsonBody": "={{ JSON.stringify($json._deferred_delivery.payload || {}) }}",
    "options": {
     "response": {
      "response": {
       "responseFormat": "text",
       "fullResponse": false
      }
     },
     "timeout": 30000
    },
    "retryOnFail": false,
    "specifyBody": "json"
   },
   "credentials": {
    "httpHeaderAuth": {
     "id": "cK3Q2aKzyXTJoCFX",
     "name": "Header Auth account"
    }
   }
  },
  {
   "id": "k2-validate-deferred-delivery",
   "name": "Validate Deferred Delivery",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1680,
    0
   ],
   "parameters": {
    "mode": "runOnceForEachItem",
    "language": "javaScript",
    "jsCode": "const raw = $json;\nconst text = typeof raw === 'string' ? raw : String(raw?.data ?? raw?.responseText ?? raw?.body ?? raw?.response ?? '');\nconst trimmed = text.trim();\nconst prior = $('Build Deferred Delivery Request').first().json || {};\nconst alreadyProcessed = prior._deferred_delivery?.already_processed === true;\nconst success = alreadyProcessed || /^ok:\\s*[0-9a-f-]{36}$/i.test(trimmed) || trimmed === 'skipped: already_delivered';\nreturn { json: { ...((raw && typeof raw === 'object') ? raw : {}), delivery_success: success, delivery_response: trimmed.slice(0, 500) } };\n"
   }
  },
  {
   "id": "k2-release-deferred-lease",
   "name": "Release K2 Conversation Lease",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.7,
