  {
   "id": "d05cdd04-e11a-45ea-aed6-6d6661a54ab8",
   "name": "Build Deferred Core Payload",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    720,
    0
   ],
   "parameters": {
    "mode": "runOnceForEachItem",
    "language": "javaScript",
    "jsCode": "const b = $json || {};\nconst batchId = String(b.batch_id || '');\nconst items = Array.isArray(b.message_items) ? b.message_items : [];\nconst last = items[items.length - 1] || {};\nconst sourceEventId = `k2-deferred-${batchId}`;\nreturn { json: {\n  clinic_id: b.clinic_id, patient_id: b.patient_id, conversation_id: b.conversation_id,\n  channel_type: b.channel_type, channel_id: b.channel_id,\n  message_id: sourceEventId, source_event_id: sourceEventId, operation_id: sourceEventId,\n  message_text: String(b.merged_message_text || '').slice(0, 6000),\n  received_at: last.received_at || new Date().toISOString(),\n  metadata: { k2_deferred_replay: true, k2_deferred_batch_id: batchId, k2_deferred_item_count: items.length, k2_deferred_message_ids: items.map((x) => x.message_id).filter(Boolean) },\n  _worker: { batch_id: batchId, claim_token: b.claim_token, attempts: b.attempts, item_count: items.length, priority: b.priority === true, conversation_lease_token: b.conversation_lease_token }\n} };"
   }
  },
