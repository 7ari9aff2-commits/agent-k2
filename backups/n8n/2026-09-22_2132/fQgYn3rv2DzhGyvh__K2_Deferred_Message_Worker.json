    "query": "SELECT public.k2_release_deferred_conversation_lease($1::uuid, $2::uuid) AS released LIMIT 1;",
    "options": {
     "queryReplacement": "={{ [$(\"Build Deferred Core Payload\").first().json.conversation_id, $(\"Build Deferred Core Payload\").first().json._worker.conversation_lease_token] }}"
    }
   },
   "credentials": {
    "postgres": {
     "id": "fHnmSTQ08g9kcLZi",
     "name": "Postgres account"
    }
   }
  },
