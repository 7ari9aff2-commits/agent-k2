     "jsCode": "const r=$json.provider_response||{};const statusCode=Number(r.statusCode??r.status??0);const b=r.body&&typeof r.body==='object'?r.body:r;const delivery=String(b.delivery||r.delivery||'').trim().toLowerCase();const failed=Boolean(b.error)||b.success===false||b.ok===false||['failed','rejected','error'].includes(delivery);const positive=b.success===true||b.ok===true||['sent','delivered','success'].includes(delivery);const delivered=!failed&&((statusCode>=200&&statusCode<300)||positive);return {json:{...$json,delivered,provider_status_code:statusCode||(positive?200:0),provider_error:b.error||b.message||''}}",
     "parameters": {
      "jsCode": "const r=$json.provider_response&&typeof $json.provider_response==='object'?$json.provider_response:{};const c=Number(r.statusCode||r.status||0);const b=r.body&&typeof r.body==='object'?r.body:r;const failed=Boolean(b&&(b.error||b.success===false||b.ok===false));return {json:{...$json,delivered:c>=200&&c<300&&!failed,provider_status_code:c||0,provider_error:failed?String(b.error||b.message||'telegram_provider_rejected'):''}}"
