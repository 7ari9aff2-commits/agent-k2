    "retryOnFail": true,
    "maxTries": 2,
    "waitBetweenTries": 1000,
    "position": [
     1240,
     540
    ],
    "parameters": {
     "operation": "executeQuery",
     "query": "WITH scope AS (SELECT c.id conversation_id,c.clinic_id,c.patient_id,c.channel_id,c.channel_conversation_id channel_patient_id,h.id handoff_id,ch.type,(SELECT s.api_token FROM public.get_channel_secret_db(c.channel_id) s LIMIT 1) token FROM public.conversations c JOIN public.channels ch ON ch.id=c.channel_id AND ch.clinic_id=c.clinic_id AND ch.provider='thikaa' AND lower(ch.type)='telegram' AND ch.status='connected' AND ch.is_enabled=true AND ch.deleted_at IS NULL JOIN public.handoff_requests h ON h.conversation_id=c.id AND h.clinic_id=c.clinic_id AND h.patient_id=c.patient_id AND h.status IN ('REQUESTED','OPEN','ASSIGNED','IN_PROGRESS') AND h.assigned_user_id=$5::uuid WHERE c.id=$2::uuid AND c.clinic_id=$1::uuid AND c.patient_id=$3::uuid AND c.channel_id=$4::uuid AND c.deleted_at IS NULL ORDER BY h.updated_at DESC LIMIT 1),old AS (SELECT status FROM public.webhook_logs WHERE provider='inbox_staff_telegram' AND idempotency_key=$7::text LIMIT 1),reserved AS (INSERT INTO public.webhook_logs(clinic_id,channel_id,provider,idempotency_key,payload,status,received_at,workflow_version,metadata) SELECT s.clinic_id,s.channel_id,'inbox_staff_telegram',$7::text,jsonb_build_object('action','send_message','conversation_id',$2::uuid,'staff_user_id',$5::uuid,'client_message_id',$7::text),'pending',now(),'inbox_outbound_telegram_v1',jsonb_build_object('handoff_id',s.handoff_id) FROM scope s WHERE NOT EXISTS(SELECT 1 FROM old) RETURNING id) SELECT CASE WHEN NOT EXISTS(SELECT 1 FROM scope) THEN 'SCOPE_DENIED' WHEN (SELECT token FROM scope) IS NULL OR btrim((SELECT token FROM scope))='' THEN 'CHANNEL_SECRET_MISSING' WHEN (SELECT status FROM old)='processed' THEN 'DUPLICATE_SENT' WHEN (SELECT status FROM old)='pending' THEN 'IN_PROGRESS' WHEN (SELECT status FROM old)='failed' THEN 'FAILED_PREVIOUS_ATTEMPT' WHEN NOT EXISTS(SELECT 1 FROM reserved) THEN 'RESERVATION_CONFLICT' ELSE 'READY' END send_state,(SELECT conversation_id FROM scope) conversation_id,(SELECT clinic_id FROM scope) clinic_id,(SELECT patient_id FROM scope) patient_id,(SELECT channel_id FROM scope) channel_id,(SELECT channel_patient_id FROM scope) channel_patient_id,(SELECT handoff_id FROM scope) handoff_id,(SELECT token FROM scope) thikaa_api_token,$6::text message_text,$7::text client_message_id,$5::uuid staff_user_id",
     "options": {
      "queryReplacement": "={{ [$json.clinic_id,$json.conversation_id,$json.patient_id,$json.channel_id,$json.staff_user_id,$json.message_text,\"inbox-staff:\"+$json.client_message_id] }}"
     }
    },
