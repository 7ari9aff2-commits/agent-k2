   "id": "01e17ac7-3d8e-4fad-a65d-4fe428aa6538",
   "name": "Normalize K2 Failure Event",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    224,
    0
   ],
   "parameters": {
    "jsCode": "const event = $json || {};\nconst execution = event.execution || {};\nconst workflow = event.workflow || {};\nconst error = event.error || {};\nreturn [{ json: {\n  error_monitor: 'agent_k2',\n  captured_at: new Date().toISOString(),\n  execution_id: execution.id || null,\n  workflow_id: workflow.id || null,\n  workflow_name: workflow.name || 'agent k2',\n  error_message: String(error.message || event.message || 'workflow_failure'),\n  error_name: error.name || null,\n  node_name: error.node?.name || error.nodeName || null,\n  hint: 'Unhandled production failure captured. No appointment mutation is performed here.'\n} }];"
   }
  },
  {
   "id": "82e51e88-e858-4ef2-820a-723d21fe2f83",
   "name": "Send Telegram K2 Alert",
   "webhookId": "fdcfedc5-585a-4e4d-acdf-e696abebd1d6",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 2000,
   "onError": "continueRegularOutput",
   "position": [
    720,
    300
   ],
   "parameters": {
    "resource": "message",
    "operation": "sendMessage",
    "chatId": "5032546660",
    "text": "={{ '🚨 K2 ALERT | ' + ($json.workflow_name || 'unknown') + ' | node: ' + ($json.node_name || '?') + ' | exec: ' + ($json.execution_id || '?') + ' | ' + String($json.error_message || '').slice(0, 350) }}",
