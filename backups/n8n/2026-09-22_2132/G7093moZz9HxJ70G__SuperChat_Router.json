 "nodes": [
  {
   "id": "1118a05d-eb80-4843-8bb0-e78193b82aff",
   "name": "Parse SuperChat Router",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -160,
    0
   ],
   "parameters": {
    "jsCode": "// Pass-through: keep the ORIGINAL SuperChat payload intact\n// so downstream workflows receive the real webhook body.\n// Also extract event type + channel_id so we can route to the\n// correct channel-specific workflow instead of broadcasting to all.\nconst body = $json.body || {};\nconst event = body.event || '';\nconst channelId = (body.message && body.message.to && body.message.to.channel_id) || null;\n\nreturn [{\n  json: {\n    body: body,\n    router_event: event,\n    router_channel_id: channelId\n  }\n}];"
   }
  },
  {
   "id": "d51c30ca-2d09-4b55-8f7d-5de34b2705d8",
