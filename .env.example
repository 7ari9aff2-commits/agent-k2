# Application
APP_NAME=Agent K2 Core Engine
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# PostgreSQL — Supabase project iqemryazzthjgztregjx (Meruna's clinics, eu-west-1)
# Prefer the session pooler (IPv4-safe). Get the password from the Supabase dashboard
# (Project Settings > Database) — DO NOT reset it via the Management API: n8n uses it too.
# Pooler:   postgresql://postgres.iqemryazzthjgztregjx:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Direct:   postgresql://postgres:[PASSWORD]@db.iqemryazzthjgztregjx.supabase.co:5432/postgres
DATABASE_URL=
DB_SSL=true
DB_POOL_MIN=2
DB_POOL_MAX=10

# Webhook auth — must match the n8n webhook headerAuth credential value
K2_INTERNAL_TOKEN=
HMAC_SECRET=
REQUIRE_HMAC=false

# Primary dialogue model (n8n credential: GLM 5.3 FLASH — node DeepSeek Model)
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=deepseek/deepseek-v4-flash-0731
LLM_TOOL_MAX_TURNS=3
LLM_TOOL_MAX_CALLS=4

# Reasoning: the n8n node sent {"reasoning": {"enabled": false}}. Reasoning models on other
# gateways (e.g. Novita zai-org/glm-5.3-flash) ignore it and still spend the completion
# budget on hidden reasoning — with a small max_tokens the visible content comes back empty.
# Leave false unless the provider actually honours the flag.
LLM_SEND_REASONING_PARAM=false
LLM_REASONING_MAX_TOKENS=2048
# No flag disables thinking on GLM 5.3 flash, but this throttles it (low: 283 -> 83
# reasoning tokens, 7.7s -> 5.4s per call). Empty string omits the parameter.
LLM_REASONING_EFFORT=low

# Final reply is authored by the model from a verified fact catalog (no reply templates).
LLM_COMPOSER_ENABLED=true
LLM_COMPOSER_TEMPERATURE=0.35
# Must cover hidden reasoning + the reply, or the composer returns empty content.
LLM_COMPOSER_MAX_TOKENS=2000
LLM_COMPOSER_MAX_ATTEMPTS=2

# Repair chain model (n8n credential: OpenAI account 2 — node DeepSeek Repair Model)
LLM_REPAIR_BASE_URL=
LLM_REPAIR_API_KEY=
LLM_REPAIR_MODEL=deepseek/deepseek-v4-flash-0731
